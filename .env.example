# Copy to .env for local development. NEVER commit the real .env.
#
# This game has no accounts and no database. It stores nothing about players — a room
# holds names and positions in memory while people are connected and forgets them when
# they leave. So there is exactly one secret:

# Gate for the /admin dashboard. In production set it with:
#   wrangler secret put ADMIN_TOKEN
# Generate one with: openssl rand -base64 24
ADMIN_TOKEN=

# Note: GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / DATABASE_URL are no longer used.
# Accounts and the database were dropped deliberately — see docs/multiplayer.md.
