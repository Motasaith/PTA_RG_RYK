# Copy to .env and fill in. NEVER commit the real .env.

# ── Google OAuth (Sign in with Google) ────────────────────────────────────────
# Client secret is SERVER-ONLY. It must never reach the browser bundle.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public copy of the client id, safe to ship to the browser.
# NOTE: Next.js uses the NEXT_PUBLIC_ prefix, not Vite's VITE_ prefix.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Database ──────────────────────────────────────────────────────────────────
# Cloudflare Workers cannot open a raw TCP socket to Postgres. This needs either
# Hyperdrive or an HTTP-based driver — see docs/multiplayer.md.
DATABASE_URL=

# ── Sessions ──────────────────────────────────────────────────────────────────
# openssl rand -base64 32
SESSION_SECRET=

# ── Admin dashboard ───────────────────────────────────────────────────────────
# Comma-separated Google account emails allowed into /admin.
ADMIN_USERS=saithmota@gmail.com,abdulraufazhar@gmail.com,binacodex@gmail.com
